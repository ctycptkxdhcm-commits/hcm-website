<%
  const pageTitle = typeof title !== 'undefined' ? `${title} | ${site.legalName}` : `${site.legalName} — ${site.tagline}`;
  const desc = typeof description !== 'undefined' ? description : site.description;
  const ogRaw = typeof ogImage !== 'undefined' ? ogImage : '/images/logo-dark.png';
  const og = /^https?:/.test(ogRaw) ? ogRaw : site.url.replace(/\/$/, '') + ogRaw.replace(u(''), '');
%><!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= desc %>">
  <link rel="canonical" href="<%= canonical %>">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="vi_VN">
  <meta property="og:site_name" content="<%= site.legalName %>">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= desc %>">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:image" content="<%= og %>">
  <meta name="theme-color" content="#111111">
  <link rel="icon" type="image/png" href="<%= u('/favicon.png') %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap">
  <link rel="stylesheet" href="<%= u('/assets/main.css') %>?v=<%= version %>">
  <script type="application/ld+json"><%- JSON.stringify({
    '@context': 'https://schema.org', '@type': 'HomeAndConstructionBusiness',
    name: site.legalName, alternateName: site.name, description: site.description,
    url: site.url, telephone: site.phone2Href ? [site.phoneHref, site.phone2Href] : site.phoneHref, email: site.email,
    address: { '@type': 'PostalAddress', streetAddress: site.address, addressRegion: site.region, addressCountry: 'VN' },
    areaServed: site.region
  }) %></script>
  <% if (site.gaId) { %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= site.gaId %>"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','<%= site.gaId %>');</script>
  <% } %>
  <script>document.documentElement.classList.add('js')</script>
</head>
