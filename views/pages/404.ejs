<%- include('../partials/header') %>
<section class="error-page">
  <div class="container container-narrow">
    <p class="error-code"><%= typeof serverError !== 'undefined' ? '500' : '404' %></p>
    <h1><%= typeof serverError !== 'undefined' ? 'Đã có lỗi xảy ra' : 'Không tìm thấy trang' %></h1>
    <p class="lead"><%= typeof serverError !== 'undefined' ? 'Hệ thống đang gặp sự cố. Vui lòng thử lại sau ít phút.' : 'Trang bạn tìm có thể đã được di chuyển hoặc không còn tồn tại.' %></p>
    <a class="btn btn-gold btn-lg" href="/">Về trang chủ</a>
  </div>
</section>
